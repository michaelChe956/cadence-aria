#!/bin/sh
# main 分支保护 + 仓库结构闸门（共享 git hook）。
#
# 安装（一次性，装到共享 gitdir 的 hooks 目录）：
#   install -m755 scripts/hooks/pre-commit "$(git rev-parse --git-common-dir)/hooks/pre-commit"
#
# 规则来源：
#   - cadence/project-rules/branch-protection.md（main 禁止直接 commit）
#   - cadence/project-rules/repo-structure-policy.md（core.bare 不可变 / 必须走 worktree / 必须走 PR）
#
# 行为：
#   - core.bare 不为 true            -> 拒绝提交（仓库结构被改坏）
#   - 当前分支为 main                -> 拒绝提交
#   - 无 HEAD / detached HEAD        -> 跳过放行

branch=$(git symbolic-ref --short HEAD 2>/dev/null)

# 闸门一：core.bare 必须恒为 true。bare 主仓被翻成 false 时，根目录会被 git
# 当成工作区，main 的 pre-commit 保护随之失效（详见 repo-structure-policy.md）。
bare=$(git config --get core.bare 2>/dev/null || true)
if [ "$bare" != "true" ]; then
    echo "拒绝提交：core.bare 必须为 true，当前为 '${bare}'。" >&2
    echo "仓库结构被改坏，main 分支保护已失效。复原：git config core.bare true" >&2
    echo "规则见 cadence/project-rules/repo-structure-policy.md" >&2
    exit 1
fi

# 取不到当前分支名（无 HEAD、detached HEAD）时跳过放行。
if [ -z "$branch" ]; then
    exit 0
fi

if [ "$branch" = "main" ]; then
    echo "禁止在 main 分支提交，规则见 cadence/project-rules/branch-protection.md" >&2
    exit 1
fi

exit 0
