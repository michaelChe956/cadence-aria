{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2024", "DOM"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": ["env/**/*.ts", "lib/**/*.ts", "spec/**/*.ts", "scripts/**/*.ts", "fixtures/**/*.ts", "playwright.config.ts", "playwright.real.config.ts"]
}
